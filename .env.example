# === Required ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
NOTION_API_KEY=ntn_your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_uuid_here
OPENAI_API_KEY=oc-your_zen_api_key_here
OPENAI_BASE_URL=http://localhost:6446/v1
OPENAI_MODEL=deepseek-v4-flash-free

# === Web UI auth ===
# Token gate for the Kaghaz web UI (all routes except /health, /login, /static).
WEB_AUTH_TOKEN=your_web_auth_token_here

# === Optional ===
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# --- Bright Data (LinkedIn / blocked-site extraction) ---
BRIGHTDATA_KEY=

# --- Odoo 19 mirror (KA → Odoo Knowledge) ---
# Enable by setting ODOO_ENABLED=true. Self-hosted instance; the mirror is
# flag-gated and non-fatal (safe to leave disabled — SQLite stays the source).
ODOO_ENABLED=false
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=production
ODOO_API_KEY=
ODOO_UID=5
ODOO_BODY_SIZE_LIMIT=50000

# --- Postgres (schema `ka`, optional back end) ---
PG_ENABLED=false
PG_HOST=127.0.0.1
PG_PORT=5544
PG_USER=odoo
PG_PASSWORD=
PG_DB=postgres
PG_SCHEMA=ka

# --- بکاپ روی ArvanCloud Object Storage (S3-compatible) ---
# پنل ابر آروان → Object Storage → Access Keys
ARVAN_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ARVAN_REGION=ir-thr-at1
ARVAN_ACCESS_KEY=
ARVAN_SECRET_KEY=
ARVAN_BUCKET=knowledge-backups
