# Odoo config template — copy to odoo/config/odoo.conf and fill real secrets.
# NEVER commit the real odoo.conf (contains admin_passwd). This template is the
# only version that lives in the repo. The running deployment reads ./config/odoo.conf
# (mounted read-only into the odoo container).
[options]
admin_passwd = CHANGE_ME_ADMIN_PASSWD
db_host = db
db_port = 5432
db_user = odoo
db_password = ${DB_PASSWORD}
addons_path = /usr/lib/python3/dist-packages/odoo/addons,/mnt/extra-addons,/var/lib/odoo/addons/19.0
data_dir = /var/lib/odoo
limit_time_cpu = 120
limit_time_real = 240
list_db = True
proxy_mode = False
